{
  "manifest_version": 3,
  "name": "Spotifly",
  "version": "1.0.0",
  "description": "Show the current song, skip, pause and search for tracks — right from the toolbar, without opening the Spotify app.",
  "permissions": ["identity", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://open.spotify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spotifly",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
